<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
    
    <TextView android:id="@+id/tvTabTitle" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:text="Tab Title" android:textSize="16sp" android:textColor="@color/text_main" android:singleLine="true"/>
        
    <ImageView android:id="@+id/btnCloseTab" android:layout_width="24dp" android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel" android:tint="@color/fx_secondary" android:padding="2dp"/>
</LinearLayout>
